HOST=0.0.0.0
PORT=4000

# Komodo integration. Leave disabled if you only want local/SSH server metrics.
KOMODO_ENABLED=false
KOMODO_URL=https://komodo.example.com
KOMODO_API_KEY=
KOMODO_API_SECRET=

# OpenCode integration. Optional.
OPENCODE_ENABLED=false
OPENCODE_API_URL=http://opencode.example.local:4096
OPENCODE_PUBLIC_URL=http://opencode.example.local:4096

# Servers to monitor. Use names that make sense for your environment.
SERVERS=server-a,server-b
SERVER_HOSTS=server-a=192.0.2.10,server-b=192.0.2.11
SERVER_USERS=server-a=admin,server-b=admin
LOCAL_SERVER_NAME=
SSH_USER=admin

# Project inventory. Optional. Reads PROJECT_STATUS.md, .opencode/status.json and SDD task files.
PROJECTS_ENABLED=false
PROJECTS_HOST=server-a
PROJECTS_PATH=/srv/projects

# Poste.io mail server metrics. Optional.
POSTE_ENABLED=false
POSTE_HOST=mail.example.com
POSTE_USER=admin
POSTE_CONTAINER=poste-io-mail-1
POSTE_DATA_PATH=/data
POSTE_DMARC_DOMAIN=example.com

REFRESH_SERVERS_SECONDS=10
REFRESH_KOMODO_SECONDS=10
REFRESH_PROJECTS_SECONDS=60
